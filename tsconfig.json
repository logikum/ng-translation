{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "./dist/out-tsc",
    "esModuleInterop": true,
    "sourceMap": true,
    "declaration": false,
    "module": "es2020",
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "target": "ES2022",
    "typeRoots": [
      "node_modules/@types"
    ],
    "lib": [
      "es2021",
      "es2021.intl",
      "dom"
    ],
    "paths": {
      "@logikum/ngt-common": [
        "./dist/ngt-common"
      ],
      "@logikum/ng-translation": [
        "dist/ng-translation"
      ],
      "@logikum/ngt-formatter": [
        "./dist/ngt-formatter"
      ],
      "@logikum/ngt-models": [
        "dist/ngt-models"
      ],
      "@logikum/icu-formatter": [
        "./dist/icu-formatter"
      ]
    },
    "resolveJsonModule": true,
    "useDefineForClassFields": false
  }
}
