{
  "name": "@logikum/ng-translation",
  "version": "9.1.1",
  "description": "NgTranslation is an internationalization and localization package for Angular applications.",
  "keywords": [
    "Angular",
    "i18n",
    "internationalization",
    "l10n",
    "localization"
  ],
  "homepage": "https://ngt.logikum.hu",
  "bugs": {
    "url": "https://github.com/logikum/ng-translation/issues"
  },
  "license": "MIT",
  "author": "Mármarosi József <marmarosi@logikum.hu>",
  "scripts": {
    "ng": "ng",
    "start": "ng serve ngt-test-site --port=4200 --open",
    "build:ngc": "ng build ngt-common",
    "build:ngt": "ng build ng-translation",
    "build:ngf": "ng build ngt-formatter",
    "build:ngm": "ng build ngt-models",
    "build:nts": "ng build ngt-test-site",
    "build:icu": "ng build icu-formatter",
    "build:its": "ng build icu-test-site",
    "build:doc": "ng build ngt-doc-site",
    "build": "npm run build:ngc && npm run build:ngf && npm run build:ngt && npm run build:ngm && npm run build:nts && npm run build:icu && npm run build:its && npm run build:doc",
    "watch:ngc": "ng build ngt-common --watch",
    "watch:ngt": "ng build ng-translation --watch",
    "watch:ngm": "ng build ngt-models --watch",
    "watch:ngf": "ng build ngt-formatter --watch",
    "watch:icu": "ng build icu-formatter --watch",
    "serve:nts": "ng serve ngt-test-site --port=4200",
    "serve:its": "ng serve icu-test-site --port=4100",
    "serve:doc": "ng serve ngt-doc-site --port=4000",
    "i18n:nts": "node tools/i18n/server.mjs projects/ngt-test-site/src projects/ngt-test-site/public/i18n/en projects/ngt-test-site/src/if-texts ngt",
    "i18n:its": "node tools/i18n/server.mjs projects/icu-test-site/src projects/icu-test-site/public/i18n/en projects/icu-test-site/src/if-texts icu",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "serve:ssr:ngt-doc-site": "node dist/ngt-doc-site/server/server.mjs"
  },
  "private": false,
  "dependencies": {
    "@angular/animations": "^19.1.5",
    "@angular/cdk": "^19.1.3",
    "@angular/common": "^19.1.5",
    "@angular/compiler": "^19.1.5",
    "@angular/core": "^19.1.5",
    "@angular/elements": "^19.1.5",
    "@angular/forms": "^19.1.5",
    "@angular/material": "^19.1.3",
    "@angular/platform-browser": "^19.1.5",
    "@angular/platform-browser-dynamic": "^19.1.5",
    "@angular/platform-server": "^19.1.5",
    "@angular/router": "^19.1.5",
    "codelyzer": "^6.0.2",
    "express": "^4.18.2",
    "highlight.js": "^11.11.1",
    "initialize-css": "^1.4.0",
    "intl-messageformat": "^10.7.16",
    "marked": "^16.0.0",
    "marked-highlight": "^2.2.2",
    "rxjs": ">=7.4.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.1.6",
    "@angular/cli": "^19.1.6",
    "@angular/compiler-cli": "^19.1.5",
    "@angular/language-service": "^19.1.5",
    "@types/express": "^4.17.17",
    "@types/highlight.js": "^9.12.3",
    "@types/node": "^18.18.0",
    "chokidar": "^4.0.3",
    "json-stable-stringify": "^1.2.1",
    "ng-packagr": "^19.1.2",
    "tslint": "~6.1.3",
    "typescript": "~5.5.4"
  },
  "main": "server.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/logikum/ng-translation.git"
  }
}
