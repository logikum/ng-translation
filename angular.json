{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "ngt-common": {
      "projectType": "library",
      "root": "projects/ngt-common",
      "sourceRoot": "projects/ngt-common/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/ngt-common/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/ngt-common/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ngt-common/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/ngt-common/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ]
          }
        }
      }
    },
    "ng-translation": {
      "projectType": "library",
      "root": "projects/ng-translation",
      "sourceRoot": "projects/ng-translation/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/ng-translation/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/ng-translation/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ng-translation/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "projects/ng-translation/src/test.ts",
            "tsConfig": "projects/ng-translation/tsconfig.spec.json",
            "karmaConfig": "projects/ng-translation/karma.conf.js"
          }
        }
      }
    },
    "ngt-formatter": {
      "projectType": "library",
      "root": "projects/ngt-formatter",
      "sourceRoot": "projects/ngt-formatter/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/ngt-formatter/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/ngt-formatter/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ngt-formatter/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/ngt-formatter/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ]
          }
        }
      }
    },
    "ngt-models": {
      "projectType": "library",
      "root": "projects/ngt-models",
      "sourceRoot": "projects/ngt-models/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/ngt-models/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/ngt-models/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ngt-models/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/ngt-models/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ]
          }
        }
      }
    },
    "functional-test-site": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "inlineTemplate": false,
          "inlineStyle": false,
          "skipTests": true
        },
        "@schematics/angular:class": {
          "skipTests": true
        },
        "@schematics/angular:directive": {
          "skipTests": true
        },
        "@schematics/angular:guard": {
          "skipTests": true
        },
        "@schematics/angular:interceptor": {
          "skipTests": true
        },
        "@schematics/angular:pipe": {
          "skipTests": true
        },
        "@schematics/angular:resolver": {
          "skipTests": true
        },
        "@schematics/angular:service": {
          "skipTests": true
        }
      },
      "root": "projects/functional-test-site",
      "sourceRoot": "projects/functional-test-site/src",
      "prefix": "fts",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/functional-test-site",
            "index": "projects/functional-test-site/src/index.html",
            "browser": "projects/functional-test-site/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/functional-test-site/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/functional-test-site/public"
              }
            ],
            "styles": [
              "projects/functional-test-site/src/styles.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "functional-test-site:build:production"
            },
            "development": {
              "buildTarget": "functional-test-site:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n"
        }
      }
    },
    "icu-formatter": {
      "projectType": "library",
      "root": "projects/icu-formatter",
      "sourceRoot": "projects/icu-formatter/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/icu-formatter/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/icu-formatter/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/icu-formatter/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/icu-formatter/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ]
          }
        }
      }
    },
    "icu-test-site": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:class": {
          "skipTests": true
        },
        "@schematics/angular:component": {
          "skipTests": true
        },
        "@schematics/angular:directive": {
          "skipTests": true
        },
        "@schematics/angular:guard": {
          "skipTests": true
        },
        "@schematics/angular:interceptor": {
          "skipTests": true
        },
        "@schematics/angular:pipe": {
          "skipTests": true
        },
        "@schematics/angular:resolver": {
          "skipTests": true
        },
        "@schematics/angular:service": {
          "skipTests": true
        }
      },
      "root": "projects/icu-test-site",
      "sourceRoot": "projects/icu-test-site/src",
      "prefix": "icu",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/icu-test-site",
            "index": "projects/icu-test-site/src/index.html",
            "browser": "projects/icu-test-site/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/icu-test-site/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/icu-test-site/public"
              }
            ],
            "styles": [
              "projects/icu-test-site/src/styles.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "icu-test-site:build:production"
            },
            "development": {
              "buildTarget": "icu-test-site:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "projects/icu-test-site/tsconfig.spec.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/icu-test-site/public"
              }
            ],
            "styles": [
              "projects/icu-test-site/src/styles.css"
            ],
            "scripts": []
          }
        }
      }
    }
  }
}
